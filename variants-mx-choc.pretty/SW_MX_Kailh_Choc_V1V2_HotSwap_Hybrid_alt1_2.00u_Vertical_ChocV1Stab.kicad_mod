(footprint "SW_MX_Kailh_Choc_V1V2_HotSwap_Hybrid_alt1_2.00u_Vertical_ChocV1Stab"
	(version 20241229)
	(generator "pcbnew")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "Cherry MX style, Kailh Choc V1 (PG1350) and V2 (PG1353) low profile mechanical keyboard switch, hot-swap socket, single-sided mounting. Plate cut lines: User.1=15.60mm square (cosmetic cover, all switches), User.2=14.00mm square with R1.00 corner relief (MX / MX Low Profile / Gateron Low Profile), User.3=13.95mm square with R1.00 corner relief (Kailh Choc V2), User.4=13.80mm square with R1.00 corner relief (Kailh Choc V1). Keycap: 2.00u vertical (1u wide x 2u tall, courtyard 19.00x38.05mm). Kailh Choc 1350 stabilizer: PCB cutout slots (Edge.Cuts) and plate cuts on User.5. Plate required. Rotated 90 deg for the vertical keycap (wire side at x=+7.25). For Choc V1 switches only (wire interferes with Choc V2).")
	(tags "switch, low_profile, hot_swap")
