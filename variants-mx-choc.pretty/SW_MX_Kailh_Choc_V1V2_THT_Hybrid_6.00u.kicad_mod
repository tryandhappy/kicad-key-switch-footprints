(footprint "SW_MX_Kailh_Choc_V1V2_THT_Hybrid_6.00u" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Compatible with Cherry MX, Kailh Choc V1 (PG1350) and Choc V2 (PG1353) mechanical keyboard switch, through-hole soldering, single-sided mounting. Plate cut lines: User.1=15.60mm square (cosmetic cover, all switches), User.2=14.00mm square with R1.00 corner relief (MX / MX Low Profile / Gateron Low Profile), User.3=13.95mm square with R1.00 corner relief (Kailh Choc V2), User.4=13.80mm square with R1.00 corner relief (Kailh Choc V1). Keycap: 6.00u (courtyard 114.25x19.00mm). No stabilizer PCB features. Plate-mount MX stabilizers can be used.")
  (tags "switch, low_profile")
  (attr through_hole)
