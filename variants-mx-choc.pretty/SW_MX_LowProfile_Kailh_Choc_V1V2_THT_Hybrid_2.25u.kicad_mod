(footprint "SW_MX_LowProfile_Kailh_Choc_V1V2_THT_Hybrid_2.25u" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Compatible with Cherry MX Low Profile, Kailh Choc V1 (PG1350) and Choc V2 (PG1353) low profile mechanical keyboard switch, through-hole soldering, single-sided mounting. Plate cut lines: User.1=15.60mm square (cosmetic cover, all switches), User.2=14.00mm square with R1.00 corner relief (MX / MX Low Profile / Gateron Low Profile), User.3=13.95mm square with R1.00 corner relief (Kailh Choc V2), User.4=13.80mm square with R1.00 corner relief (Kailh Choc V1). Keycap: 2.25u (courtyard 42.81x19.00mm). No stabilizer PCB features. Plate-mount MX stabilizers can be used.")
  (tags "switch, low_profile")
  (attr through_hole)
