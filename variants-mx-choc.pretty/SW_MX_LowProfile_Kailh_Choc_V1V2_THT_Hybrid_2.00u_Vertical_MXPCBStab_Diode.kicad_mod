(footprint "SW_MX_LowProfile_Kailh_Choc_V1V2_THT_Hybrid_2.00u_Vertical_MXPCBStab_Diode" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Compatible with Cherry MX Low Profile, Kailh Choc V1 (PG1350) and Choc V2 (PG1353) low profile mechanical keyboard switch, through-hole soldering, single-sided mounting. Plate cut lines: User.1=15.60mm square (cosmetic cover, all switches), User.2=14.00mm square with R0.60 corner relief (center inset 0.35) (MX / MX Low Profile / Gateron Low Profile), User.3=13.95mm square with R0.60 corner relief (center inset 0.35) (Kailh Choc V2), User.4=13.80mm square with R0.60 corner relief (center inset 0.35) (Kailh Choc V1). Keycap: 2.00u vertical (1u wide x 2u tall, courtyard 19.00x38.05mm). Cherry MX PCB-mount stabilizer holes included (vertical 2u, wire side at x=-8.255). Stabilizer plate cut on User.5 (fits plate-mount and PCB-mount MX stabilizers). Series diode pads on back side: pad 3 = anode, pad 4 = cathode (cathode bar on B.SilkS, body outline on B.Fab, cathode points up). Combined hand-soldering land for SOD-123 / SOD-323 / MiniMELF (LL-34, LL4148): 2.0x1.4mm pads at +/-1.6mm axial offset. With the bundled SW_Key_Diode symbol pins 2 and 3 are stacked (one net), so the switch-diode series circuit is complete at schematic level; on the PCB route the short pad 2 - pad 3 track shown by the ratsnest, and wire the matrix to pads 1 and 4.")
  (tags "switch, low_profile, diode")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -8.5 unlocked) (layer "F.SilkS") hide
      (effects (font (size 1 1) (thickness 0.15)))
    (tstamp fb10519d-6257-4544-aa9c-d31af89f259c)
  )
