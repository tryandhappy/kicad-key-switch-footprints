(footprint "SW_Kailh_Choc_V1_HotSwap_THT_6.25u_ChocStab" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Kailh Choc V1 (PG1350) low profile mechanical keyboard switch, hot-swap socket and through-hole soldering, single-sided mounting. Plate cut lines: User.1=15.60mm square (cosmetic cover, all switches), User.4=13.80mm square (Kailh Choc V1). Keycap: 6.25u (courtyard 119.01x19.00mm). Kailh Choc 1350 stabilizer: PCB cutout slots (Edge.Cuts) and plate cuts on User.5. Plate required.")
