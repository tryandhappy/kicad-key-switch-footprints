(footprint "SW_Kailh_Choc_V1V2_THT_Hybrid_6.25u_ChocStab" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Compatible with Kailh Choc V1 (PG1350) and Choc V2 (PG1353) low profile mechanical keyboard switch, through-hole soldering, single-sided mounting. Plate cut lines: User.1=15.60mm square (cosmetic cover, all switches), User.3=13.95mm square (Kailh Choc V2), User.4=13.80mm square (Kailh Choc V1). Keycap: 6.25u (courtyard 119.01x19.00mm). Kailh Choc 1350 stabilizer: PCB cutout slots (Edge.Cuts) and plate cuts on User.5. Plate required.")
  (tags "switch, low_profile")
