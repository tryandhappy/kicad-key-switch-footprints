(footprint "SW_Gateron_LowProfile_HotSwap_PTH_2.00u" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Gateron Low Profile (KS-27 & KS-33) style mechanical keyboard switch, Gateron Low Profile hot-swap socket and through-hole soldering, the hole of the socket is plated, single-sided mounting. Gateron Low Profile and Cherry MX Low Profile are NOT compatible. Plate cut lines: User.1=15.60mm square (cosmetic cover, all switches), User.2=14.00mm square with R1.00 corner relief (MX / MX Low Profile / Gateron Low Profile). Keycap: 2.00u (courtyard 38.05x19.00mm). No stabilizer PCB features. For Kailh Choc V2 stabilizers use the _ChocV2Stab variant. For Gateron Low Profile plate-mount stabilizers use the _GateronLPStab variant.")
  (tags "switch, low_profile, hot_swap")
