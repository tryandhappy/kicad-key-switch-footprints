(footprint "SW_Gateron_LowProfile_THT_6.25u_GateronLPStab" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Gateron Low Profile (KS-27 & KS-33) style mechanical keyboard switch, through-hole soldering, single-sided mounting. Gateron Low Profile and Cherry MX Low Profile are NOT compatible. Plate cut lines: User.1=15.60mm square (cosmetic cover, all switches), User.2=14.00mm square with R0.60 corner relief (center inset 0.35) (MX / MX Low Profile / Gateron Low Profile). Keycap: 6.25u (courtyard 119.01x19.00mm). Gateron Low Profile plate-mount stabilizer (KS-57B623T): plate cuts on User.5 (overlapping outlines; union in plate CAD). No PCB features; clearance between plate and PCB under the stabilizer housing is not verified.")
  (tags "switch, low_profile")
