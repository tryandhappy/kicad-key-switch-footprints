(footprint "SW_Kailh_Choc_V1V2_HotSwap_Hybrid_6.25u_ChocV1Stab"
	(version 20241229)
	(generator "pcbnew")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "Kailh Choc V1 (PG1350) and Choc V2 (PG1353) low profile mechanical keyboard switch, hot-swap socket, single-sided mounting. Plate cut lines: User.1=15.60mm square (cosmetic cover, all switches), User.3=13.95mm square with R1.00 corner relief (Kailh Choc V2), User.4=13.80mm square with R1.00 corner relief (Kailh Choc V1). Keycap: 6.25u (courtyard 119.01x19.00mm). Kailh Choc 1350 stabilizer: PCB cutout slots (Edge.Cuts) and plate cuts on User.5. Plate required. For Choc V1 switches only (wire interferes with Choc V2).")
	(tags "switch, low_profile, hot_swap")
